# === AI API Keys (comma-separated for rotation) ===
ANTHROPIC_API_KEYS=
OPENAI_API_KEYS=
GEMINI_API_KEYS=

# === Default LLM settings ===
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_TIMEOUT=20
LLM_MAX_RETRIES=2

# === Offline mode (1 = no AI calls, deterministic fallback only) ===
OFFLINE=0

# === Server ===
HOST=0.0.0.0
PORT=8000
DEBUG=1

# === Storage ===
DATA_DIR=./data
ARTIFACT_TTL_HOURS=1
MAX_UPLOAD_MB=200

# === Security ===
PROJECT_SALT=synthgen-hackathon-2026
